module

public import VerifiedEval.Demos.MagmaLawDemo
public meta import VerifiedEval.Demos.MagmaLawDemo
public import VerifiedEval.FragmentReflect
public import VerifiedEval.FragmentSpecTac

/-!
# Decision procedures whose reification step is a generated theorem

The substring search of `VerifiedEval.VerifiedDecideDemo` and the magma-law checker of
`VerifiedEval.Demos.MagmaLawDemo`, each written as a Lean function in the fragment's surface,
reified by `reifyFragment%`, and registered as a `DecisionProc` whose `spec` uses the theorem
produced by `fragment_theorem` for the reified program. (The hand-written `substrProg` and
`lawProg` get their generated theorems `substrProg_correct` and `lawProg_correct` by
normalisation, in their own modules; `lawSrc` is defined in `VerifiedEval.Demos.MagmaLawDemo`.)

`substrSrc` uses the bounds of `substrProg` (16 starts, 4 offsets); its reified program
`substrProgR` is `substrProg` up to `skip` preludes, the initial assignments of the
accumulators and the name of the result local, and takes the layout and register plan of
`substrProg` with that name changed. `lawSrc` reads the table as an array of words and
converts between `Nat` and `UInt64` at the indices; its reified program `lawProgR` has the
expressions of `lawProg`.

What remains manual in each `spec` is the link from the source function to the proposition:
`substrSrc_eq` (the source as `List.any` of `foundAt`, then the chain of `substr_spec`) and
`lawSrc_eq` (the source as `List.all` of `lawAt`, by index arithmetic at entries below 8), and
the agreement of the source state with the encodings of the arguments (`agree_substrState`,
`agree_lawState`).

## Main definitions

* `substrSrc`, `substrProgR`, `substrDecideR`: the substring search.
* `lawSrc`, `lawProgR`, `lawDecideR`: the magma law.

## Main results

* `substrProgR_correct`, `lawProgR_correct`: generated by `fragment_theorem`.
* `substrR_spec`, `lawR_spec`: the `spec` fields.
* `substrR_hello`, `rotTable_lawR`: decided by `verified_decide`.
-/

set_option autoImplicit false

@[expose] public section

namespace VerifiedEval.SpecAuto

open VerifiedEval VerifiedEval.Spec

/-- Whether `n` occurs in `h` at a start below 16, comparing 4 offsets, in the fragment's
surface; the search of `substrProg`. -/
def substrSrc (h n : Array UInt8) : Bool :=
  (List.range 16).foldl (fun f i =>
    let ok := (List.range 4).foldl
      (fun ok j => (decide (n.size ≤ j) || n[j]! == h[i + j]!) && ok) true
    f || (ok && decide (i + n.size ≤ h.size))) false

/-- The reified substring search. -/
def substrProgR : FProg := reifyFragment% substrSrc

fragment_theorem substrProgR_correct : substrSrc ~> substrProgR

/-- The layout of `substrProgR`: the layout of `substrProg` with the result local `result`. -/
def substrLayoutR : Layout := stdLayout ["i", "j", "ok", "result"] ["h", "n"]

/-- The register plan of `substrProgR`: that of `substrProg` with `f` renamed `result`. -/
def substrPlanR : RegPlan :=
  [(.gThen 0, 4), (.sink, 3), (.len "h", 5), (.ptr "h", 6), (.len "n", 7), (.ptr "n", 8),
   (.var "i", 9), (.var "j", 10), (.var "ok", 11), (.var "result", 12),
   (.tmp 0, 0), (.tmp 1, 1), (.tmp 2, 2), (.tmp 3, 13), (.tmp 4, 14), (.tmp 5, 15)]

theorem substrProgR_fitsL : substrProgR.fitsL substrLayoutR (fun _ => 16) = true := by decide

theorem substrProgR_litsFitL : substrProgR.litsFitL = true := by decide

theorem substrProgR_planCheck : planCheck substrLayoutR substrPlanR substrProgR = true := by
  decide

/-! ### The link from the source function to `IsSubstr` (manual) -/

theorem beq_get_eq (h n : Array UInt8) (i j : Nat) :
    (n[j]! == h[i + j]!) = decide ((encArr n).getD j 0 = (encArr h).getD (i + j) 0) := by
  rw [encArr, encArr, getD_map_enc, getD_map_enc, ← getElem!_eq_getD, ← getElem!_eq_getD]
  by_cases e : n[j]! = h[i + j]!
  · simp [e]
  · have : enc n[j]! ≠ enc h[i + j]! := fun h' => e (FWord.inj _ _ h')
    simp [e, this]

/-- The source function is the search of `substrProg`'s specification, on the cells of the
arrays. -/
theorem substrSrc_eq (h n : Array UInt8) :
    substrSrc h n = (List.range 16).any (foundAt (encArr h) (encArr n)) := by
  have hn : (encArr n).length = n.size := by simp [encArr]
  have hh : (encArr h).length = h.size := by simp [encArr]
  simp only [substrSrc, foldl_and, foldl_or, Bool.false_or, Bool.and_true, beq_get_eq]
  congr 1
  funext I
  simp only [foundAt, hn, hh]
  congr 2
  funext j
  simp only [okAt, hn]

/-- The array of the bytes of an ASCII string. -/
def arrOf (s : String) : Array UInt8 := ((asciiBytes s).map UInt8.ofBitVec).toArray

theorem encArr_arrOf (s : String) : encArr (arrOf s) = cellsOf s := by
  simp only [encArr, arrOf, cellsOf, List.toList_toArray, List.map_map]
  apply List.map_congr_left
  intro b _
  apply BitVec.eq_of_toNat_eq
  simp [Function.comp, FEnc.enc]

theorem arrOf_size (s : String) : (arrOf s).size = s.length := by
  simp [arrOf, asciiBytes, String.length_toList]

theorem agree_substrState (x : String × String) :
    Agree [] [("h", encArr (arrOf x.1)), ("n", encArr (arrOf x.2))] (substrState x) := by
  refine ⟨fun _ _ h => by simp [List.lookup] at h, fun s b hs => ?_⟩
  rw [encArr_arrOf, encArr_arrOf] at hs
  by_cases e1 : s = "h"
  · subst e1; simp_all [List.lookup, substrState]
  · by_cases e2 : s = "n"
    · subst e2; simp_all [List.lookup, substrState]
    · have h1 : (s == "h") = false := by simp [e1]
      have h2 : (s == "n") = false := by simp [e2]
      simp [List.lookup, h1, h2] at hs

/-- **Specification of the reified substring program.** The reification step is the generated
theorem `substrProgR_correct`; the rest is the link from `substrSrc` to `IsSubstr`, shared with
`substr_spec`. -/
theorem substrR_spec (x : String × String) (hx : substrAdmit x = true) :
    substrProgR.run (substrState x) = true ↔ IsSubstr x := by
  obtain ⟨h1, h2, hs, hn⟩ := substrAdmit_spec hx
  have hH : (cellsOf x.1).length ≤ 16 := by rw [cellsOf_length]; exact h1
  have hN : (cellsOf x.2).length ≤ 4 := by rw [cellsOf_length]; exact h2
  rw [substrProgR_correct (arrOf x.1) (arrOf x.2) (by rw [arrOf_size]; omega)
      (by rw [arrOf_size]; omega) _ (agree_substrState x),
    substrSrc_eq, encArr_arrOf, encArr_arrOf, any_foundAt_iff hH hN, ← infix_iff_index, cellsOf,
    cellsOf, map_infix_iff setWidth_injective, ← spanSearch_iff,
    ← substring_iff_spanSearch _ _ hs hn]
  rfl

theorem substrStateR_length {x : String × String} (hx : substrAdmit x = true) :
    ∀ t ∈ substrLayoutR.spans, ((substrState x).bufs t).length ≤ 16 := by
  obtain ⟨h1, h2, -, -⟩ := substrAdmit_spec hx
  intro t ht
  simp only [substrLayoutR, stdLayout, List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl <;> simp [substrState, cellsOf_length] <;> omega

/-- The reified substring search registered as a decision procedure for `IsSubstr`. -/
def substrDecideR : DecisionProc (String × String) IsSubstr where
  prog := substrProgR
  layout := substrLayoutR
  plan := substrPlanR
  cap := fun _ => 16
  toState := substrState
  admit := substrAdmit
  layoutOK := stdLayout_ok _ _
  fitsL := substrProgR_fitsL
  litsFitL := substrProgR_litsFitL
  planOK := substrProgR_planCheck
  admit_capOK := fun _ hx t ht => substrStateR_length hx t ht
  admit_lenLt := fun _ hx t ht => by have := substrStateR_length hx t ht; omega
  spec := substrR_spec

/-! ## The magma law -/

/-- The reified law checker. -/
def lawProgR : FProg := reifyFragment% lawSrc

fragment_theorem lawProgR_correct : lawSrc ~> lawProgR

/-- The layout of `lawProgR`: the layout of `lawProg` with the result local `result`. -/
def lawLayoutR : Layout := stdLayout ["x", "y", "result"] ["t"]

/-- The register plan of `lawProgR`: that of `lawProg` with `ok` renamed `result`. -/
def lawPlanR : RegPlan :=
  [(.gThen 0, 4), (.sink, 3), (.len "t", 5), (.ptr "t", 6),
   (.var "x", 7), (.var "y", 8), (.var "result", 9),
   (.tmp 0, 0), (.tmp 1, 1), (.tmp 2, 2), (.tmp 3, 10), (.tmp 4, 11), (.tmp 5, 12),
   (.tmp 6, 13), (.tmp 7, 14), (.tmp 8, 15)]

theorem lawProgR_fitsL : lawProgR.fitsL lawLayoutR (fun _ => 64) = true := by decide

theorem lawProgR_litsFitL : lawProgR.litsFitL = true := by decide

theorem lawProgR_planCheck : planCheck lawLayoutR lawPlanR lawProgR = true := by decide

/-! ### The link from the source function to `SatisfiesLaw` (manual) -/

theorem agree_lawState (T : List Nat) : Agree [] [("t", encArr (arrT T))] (lawState T) := by
  refine ⟨fun _ _ h => by simp [List.lookup] at h, fun s b hs => ?_⟩
  rw [encArr_arrT] at hs
  by_cases e : s = "t"
  · subst e; simp_all [List.lookup, lawState]
  · have h1 : (s == "t") = false := by simp [e]
    simp [List.lookup, h1] at hs

/-- **Specification of the reified law program.** The reification step is the generated
theorem `lawProgR_correct`; the rest is the link from `lawSrc` to `SatisfiesLaw`. -/
theorem lawR_spec (T : List Nat) (hT : lawAdmit T = true) :
    lawProgR.run (lawState T) = true ↔ SatisfiesLaw T := by
  obtain ⟨hlen, hlt⟩ := lawAdmit_spec hT
  rw [lawProgR_correct (arrT T) (by simp [arrT, hlen]) _ (agree_lawState T), lawSrc_eq hlt]
  simp [SatisfiesLaw, lawAt, List.all_eq_true, List.mem_range]

theorem lawStateR_length {T : List Nat} (hT : lawAdmit T = true) :
    ∀ t ∈ lawLayoutR.spans, ((lawState T).bufs t).length ≤ 64 := by
  intro t ht
  simp only [lawLayoutR, stdLayout, List.mem_cons, List.not_mem_nil, or_false] at ht
  subst ht
  simp [lawState, tableCells, (lawAdmit_spec hT).1]

/-- The reified law checker registered as a decision procedure for `SatisfiesLaw`. -/
def lawDecideR : DecisionProc (List Nat) SatisfiesLaw where
  prog := lawProgR
  layout := lawLayoutR
  plan := lawPlanR
  cap := fun _ => 64
  toState := lawState
  admit := lawAdmit
  layoutOK := stdLayout_ok _ _
  fitsL := lawProgR_fitsL
  litsFitL := lawProgR_litsFitL
  planOK := lawProgR_planCheck
  admit_capOK := fun _ hx t ht => lawStateR_length hx t ht
  admit_lenLt := fun _ hx t ht => by have := lawStateR_length hx t ht; omega
  spec := lawR_spec

/-! ## Decided instances -/

theorem substrR_hello : IsSubstr ("hello world", "lo w") := by verified_decide substrDecideR

theorem rotTable_lawR : SatisfiesLaw rotTable := by verified_decide lawDecideR

/--
info: 'VerifiedEval.SpecAuto.substrR_spec' depends on axioms: [propext, Classical.choice, Quot.sound]
-/
#guard_msgs in
#print axioms substrR_spec

/--
info: 'VerifiedEval.SpecAuto.lawR_spec' depends on axioms: [propext, Classical.choice, Quot.sound]
-/
#guard_msgs in
#print axioms lawR_spec

end VerifiedEval.SpecAuto

end
